# %%
L2 = 20                                # Breite des Streifens (Zellen)
pos, iA, iB, D = honeycomb(1, L2, periodic=(True, False))
N = 2*L2
b1 = np.array([2*np.pi/np.sqrt(3), 2*np.pi/3])

w, K0 = 12.0, 1.0
T = 2*np.pi / w
rand = 5                                   # so viele Zellen zählen als "Rand"
n2 = np.arange(N) // 2                     # Zeilennummer jedes Platzes

thetas = np.linspace(-np.pi, np.pi, 61)
TH, EPS, COL = [], [], []
for th in thetas:
    k = th/(2*np.pi) * b1
    fb = qt.FloquetBasis(H_qutip(N, iA, iB, D, K0, w, k), T)
    modes = np.array([m.full().ravel() for m in fb.mode(0)])   # Zeilen = Zustände
    dichte = np.abs(modes)**2
    oben  = dichte[:, n2 >= L2 - rand].sum(axis=1)
    unten = dichte[:, n2 <  rand].sum(axis=1)
    TH  += [th] * N
    EPS += list(fb.e_quasi)
    COL += list(oben - unten)

plt.scatter(TH, EPS, c=COL, cmap='coolwarm', vmin=-1, vmax=1, s=4)
plt.colorbar(label='oben − unten')
plt.xlabel('θ (Impuls entlang des Randes)'); plt.ylabel('Quasienergie / J')
#plt.ylim(-1, 1)                            # Zoom auf die Lücke
for m in [-1, 0, 1]:
    plt.scatter(TH, np.array(EPS) + m*w, c=COL, cmap='coolwarm', vmin=-1, vmax=1, s=4)
plt.ylim(-1.5*w, 1.5*w)
plt.show()
