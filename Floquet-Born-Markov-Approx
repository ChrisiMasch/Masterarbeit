def H_t(t, N, iA, iB, D, K0, w):
    A = K0 * np.array([np.cos(w*t), np.sin(w*t)])   # Vektorpotential zur Zeit t
    h = -J * np.exp(1j * D @ A)                      # ein Wert pro Bindung
    H = np.zeros((N, N), dtype=complex)
    H[iB, iA] = h
    H[iA, iB] = np.conj(h)
    return H

w, K0 = 10.0, 1.0
T = 2*np.pi / w

Ht = H_t(0.3, N, iA, iB, D, K0, w)
print(np.allclose(Ht, Ht.conj().T))                                  # 1. hermitesch
print(np.allclose(H_t(0.3, N, iA, iB, D, 0.0, w), H0))               # 2. K0=0 gibt H0
print(np.allclose(H_t(0.3, N, iA, iB, D, K0, w),
                  H_t(0.3 + T, N, iA, iB, D, K0, w)))                # 3. periodisch in T
print(np.allclose(np.abs(Ht[iB, iA]), J))                            # 4. Betrag bleibt J
