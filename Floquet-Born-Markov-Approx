import qutip as qt

def make_coeff(K0, w, phi, sign):
    def c(t):
        return np.exp(sign * 1j * K0 * np.cos(w*t + phi))
    return c

def H_qutip(N, iA, iB, D, K0, w):
    phis = np.round(np.arctan2(D[:, 1], D[:, 0]), 6)   # Winkel jeder Bindung
    H = []
    for phi in np.unique(phis):                          # die 3 Richtungen
        sel = (phis == phi)                              # Bindungen dieser Richtung
        M = np.zeros((N, N), dtype=complex)
        M[iB[sel], iA[sel]] = -J                         # A -> B
        Mq = qt.Qobj(M)
        H.append([Mq,       make_coeff(K0, w, phi, +1)])
        H.append([Mq.dag(), make_coeff(K0, w, phi, -1)]) # B -> A
    return H

# Rechnen
L = 4
pos, iA, iB, D = honeycomb(L, L, periodic=(True, True))
N = 2*L*L
w, K0 = 10.0, 1.0
T = 2*np.pi / w

fb = qt.FloquetBasis(H_qutip(N, iA, iB, D, K0, w), T)
eps_qutip = fb.e_quasi
# %%
def floquet_U(N, iA, iB, D, K0, w, Nt=200):
    T = 2*np.pi / w
    dt = T / Nt
    U = np.eye(N, dtype=complex)
    for n in range(Nt):
        t = (n + 0.5) * dt
        U = expm(-1j * H_t(t, N, iA, iB, D, K0, w) * dt) @ U
    return U

def quasienergies(U, w):
    T = 2*np.pi / w
    lam = np.linalg.eigvals(U)
    return np.sort(-np.angle(lam) / T)
eps_eigen = quasienergies(floquet_U(N, iA, iB, D, K0, w, Nt=400), w)

print(np.max(np.abs(np.sort(eps_qutip) - eps_eigen)))   # sollte klein sein (~1e-4 oder besser)

