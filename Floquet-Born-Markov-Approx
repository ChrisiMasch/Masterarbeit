#Hamiltonian:
def H_static(N, iA, iB):
    H = np.zeros((N, N))
    H[iB, iA] = -J      # Tunneln von A nach B
    H[iA, iB] = -J      # Tunneln von B nach A (macht H hermitesch)
    return H

L = 9
pos, iA, iB, D = honeycomb(L, L, periodic=(True, True))
N = 2*L*L
H0 = H_static(N, iA, iB)
E = np.linalg.eigvalsh(H0)

print(np.allclose(H0, H0.T))               # 1. hermitesch (hier reell, also symmetrisch)
print(np.all((H0 != 0).sum(axis=1) == 3))  # 2. jeder Platz hat 3 Nachbarn
print(E.min(), E.max())                     # 3. genau -3 und +3
print(np.allclose(E, -E[::-1]))             # 4. Spektrum symmetrisch
print(np.sum(np.abs(E) < 1e-10))            # 5. Dirac-Punkte: 4 Nullen
