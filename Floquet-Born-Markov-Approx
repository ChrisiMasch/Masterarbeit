import numpy as np
import matplotlib.pyplot as plt
from scipy.linalg import expm
#%%
# Konstanten
J = 1.0
a1 = np.array([ np.sqrt(3)/2, 1.5]) #Gittervektoren
a2 = np.array([-np.sqrt(3)/2, 1.5])
dAB = np.array([0.0, 1.0]) #B-Platz relativ zum A-Platz in derselben Zell

# Gitter bauen
def honeycomb(L1, L2, periodic=False):

    def idx(n1, n2, s):
        return 2*(n1*L2 + n2) + s
    

    N = 2*L1*L2 #Anzahl der Gitterplätze
    pos = np.zeros((N, 2))
    bonds = []

    for n1 in range(L1):
        for n2 in range(L2):
            R = n1*a1 + n2*a2
            pos[idx(n1, n2, 0)] = R
            pos[idx(n1, n2, 1)] = R + dAB
            for c1, c2 in [(0, 0), (-1, 0), (0, -1)]:
                m1, m2 = n1 + c1, n2 + c2
                if periodic[0]: m1 %= L1
                if periodic[1]: m2 %= L2
                if not (0 <= m1 < L1 and 0 <= m2 < L2):
                    continue
                delta = dAB + c1*a1 + c2*a2
                bonds.append((idx(n1, n2, 0), idx(m1, m2, 1), delta))
    iA = np.array([b[0] for b in bonds])
    iB = np.array([b[1] for b in bonds])
    D  = np.array([b[2] for b in bonds])
    return pos, iA, iB, D

# Gitter erzeugen und zeichnen
pos, iA, iB, D = honeycomb(9, 9, periodic=[True, True])
#%%
for i, j in zip(iA, iB):
