# %%
def make_coeff(K0, w, phi, sign, kphase=0.0):
    def c(t):
        return np.exp(sign * 1j * (K0 * np.cos(w*t + phi) + kphase))
    return c

def H_qutip(N, iA, iB, D, K0, w, k=np.zeros(2)):
    phis = np.round(np.arctan2(D[:, 1], D[:, 0]), 6)
    H = []
    for phi in np.unique(phis):
        sel = (phis == phi)
        delta = D[sel][0]                       # Bindungsvektor dieser Richtung
        kphase = k @ delta                      # Bloch-Phase
        M = np.zeros((N, N), dtype=complex)
        M[iB[sel], iA[sel]] = -J
        Mq = qt.Qobj(M)
        H.append([Mq,       make_coeff(K0, w, phi, +1, kphase)])
        H.append([Mq.dag(), make_coeff(K0, w, phi, -1, kphase)])
    return H
